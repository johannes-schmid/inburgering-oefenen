# Copy to .env.local for local development.
# Set these in Vercel → Settings → Environment Variables for production.

BASE_URL=https://inburgeringoefenen.nl

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Public Supabase vars — safe to expose in the browser.
# next.config.ts maps SUPABASE_URL / SUPABASE_ANON_KEY onto these names.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Payments (Mollie, iDEAL-first) ──────────────────────────────────────────
MOLLIE_API_KEY=test_your_mollie_test_key_here
MOLLIE_WEBHOOK_URL=https://inburgeringoefenen.nl

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_api_key_here
# Verified sender address — must match a domain verified in your Resend dashboard.
RESEND_FROM_EMAIL=Docent <docent@inburgeringoefenen.nl>
# Resend Segment ID for paying customers (Resend dashboard → Contacts → Segments)
RESEND_PREMIUM_SEGMENT_ID=your_resend_segment_id

# Secret used to authenticate Vercel Cron requests to /api/send-campaign-emails
CRON_SECRET=your_cron_secret_here

# ── Text-to-speech (ElevenLabs) ─────────────────────────────────────────────
# Luisteren stimulus audio, question read-aloud, lesson audio.
# NOTE: the variable name is misspelled ("LAPS") throughout the codebase — keep it as is.
ELEVEN_LAPS_API_KEY=your_elevenlabs_api_key_here

# ── AI grading (Schrijven + Spreken) ────────────────────────────────────────
# Vercel AI Gateway — grades open answers against the docent's rubric.
AI_GATEWAY_API_KEY=your_vercel_ai_gateway_key_here

# Anthropic API key — used server-side only to generate Pexels search queries via Haiku
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Pexels API key — used server-side only for admin image search
PEXELS_API_KEY=your_pexels_api_key_here
