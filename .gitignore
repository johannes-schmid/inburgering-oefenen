.env*.local
# The Supabase CLI reads `.env` from the repo root (it does NOT read .env.development.local,
# which is a Next.js convention), so `.env` holds the local Google OAuth credentials. This repo
# is public — everything except the checked-in example stays out.
.env
.env.*
!.env.example
.vercel
*.tsbuildinfo
next-env.d.ts
/playwright-report
/test-results
/temporary_screenshots
.DS_Store

.claude/worktrees
supabase/.temp

# resources/ is local working material and is NOT published. It holds the official DUO
# exam material (© Ministerie van SZW, explicitly not for redistribution) plus inherited
# KNM source files. Everything stays on disk; nothing reaches the remote.
# Exception: resources/images/ holds the hero source that scripts/build-hero-image.mjs
# needs, so that one directory is tracked.
/resources/*
!/resources/images/

# Stray duplicate image dir (not referenced by any code)
/images/

# Machine-local Claude settings. The permissions allowlist records past shell commands
# verbatim, so it can contain API keys that were passed inline — never commit it.
.claude/settings.local.json
